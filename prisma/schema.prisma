// Prisma schema for Zendify SaaS - WhatsApp Business Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Company {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  cnpj              String?
  logoUrl           String?
  status            String             @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELED
  planId            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  plan              Plan?              @relation(fields: [planId], references: [id])
  users             User[]
  contacts          Contact[]
  tags              Tag[]
  segments          Segment[]
  campaigns         Campaign[]
  templates         Template[]
  automations       Automation[]
  whatsappAccounts  WhatsAppAccount[]
  webhooks          Webhook[]
  optOuts           OptOut[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]
  conversations     Conversation[]
}

model User {
  id           String      @id @default(uuid())
  companyId    String
  name         String
  email        String      @unique
  passwordHash String
  avatarUrl    String?
  role         String      @default("OPERATOR") // SUPER_ADMIN, COMPANY_ADMIN, OPERATOR
  status       String      @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]
}

model Plan {
  id                 String         @id @default(uuid())
  name               String         // FREE, STARTER, PRO, ENTERPRISE
  code               String         @unique
  priceMonthly       Float          @default(0)
  maxUsers           Int            @default(1)
  maxContacts        Int            @default(100)
  maxCampaignsMonth  Int            @default(5)
  maxMessagesMonth   Int            @default(500)
  allowAutomations   Boolean        @default(false)
  allowApi           Boolean        @default(false)
  createdAt          DateTime       @default(now())

  companies          Company[]
  subscriptions      Subscription[]
}

model Subscription {
  id                   String    @id @default(uuid())
  companyId            String
  planId               String
  status               String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, TRIAL
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())

  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                 Plan      @relation(fields: [planId], references: [id])
}

model Contact {
  id                 String              @id @default(uuid())
  companyId          String
  firstName          String
  lastName           String?
  phone              String              // Format E.164 (e.g. +5511999999999)
  whatsapp           String              // Formatted WhatsApp number
  email              String?
  companyName        String?
  city               String?
  state              String?
  status             String              @default("ACTIVE") // ACTIVE, BLOCKED, INACTIVE, OPTED_OUT
  source             String              @default("MANUAL") // MANUAL, CSV, API, AUTOMATION, WEBHOOK
  consent            Boolean             @default(true)
  consentDate        DateTime            @default(now())
  consentSource      String              @default("OPT_IN_FORM")
  lastInteractionAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactTags        ContactTag[]
  campaignRecipients CampaignRecipient[]
  messages           Message[]
  conversations      Conversation[]
  optOuts            OptOut[]

  @@unique([companyId, phone])
}

model Tag {
  id          String       @id @default(uuid())
  companyId   String
  name        String
  color       String       @default("#3B82F6")
  createdAt   DateTime     @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]

  @@unique([companyId, name])
}

model ContactTag {
  contactId String
  tagId     String
  assignedAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Segment {
  id          String     @id @default(uuid())
  companyId   String
  name        String
  description String?
  rulesJson   String     // JSON defining filters (tags, city, state, date, status, etc.)
  contactCount Int       @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
}

model WhatsAppAccount {
  id             String     @id @default(uuid())
  companyId      String
  name           String     @default("Oficial WABA")
  wabaId         String?
  phoneNumberId  String?
  accessToken    String?    // Encrypted token or store
  displayPhone   String?
  qualityRating  String     @default("GREEN") // GREEN, YELLOW, RED
  status         String     @default("CONNECTED") // CONNECTED, PENDING, DISCONNECTED, MOCK_MODE
  webhookUrl     String?
  verifyToken    String?
  isDefault      Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  webhooks       Webhook[]
}

model Webhook {
  id                String           @id @default(uuid())
  companyId         String
  whatsappAccountId String?
  name              String           @default("Webhook Principal")
  url               String
  eventsJson        String           // Array of subscribed events
  secret            String?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id])
}

model Template {
  id          String     @id @default(uuid())
  companyId   String
  name        String
  language    String     @default("pt_BR")
  category    String     @default("MARKETING") // MARKETING, UTILITY, AUTHENTICATION, SERVICE, PROMOTION, BILLING, INFO
  status      String     @default("APPROVED") // APPROVED, PENDING, REJECTED
  metaId      String?
  headerType  String     @default("NONE") // NONE, TEXT, IMAGE, VIDEO, DOCUMENT
  headerMedia String?
  bodyText    String
  footerText  String?
  buttonsJson String?    // JSON array of buttons (URL, QUICK_REPLY, PHONE_NUMBER)
  variables   String?    // CSV list of detected variables like {{1}}, {{2}}
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
}

model Campaign {
  id                String              @id @default(uuid())
  companyId         String
  whatsappAccountId String?
  segmentId         String?
  templateId        String?
  name              String
  status            String              @default("DRAFT") // DRAFT, SCHEDULED, PROCESSING, PAUSED, COMPLETED, CANCELED
  scheduledFor      DateTime?
  sentCount         Int                 @default(0)
  deliveredCount    Int                 @default(0)
  readCount         Int                 @default(0)
  repliedCount      Int                 @default(0)
  failedCount       Int                 @default(0)
  totalRecipients   Int                 @default(0)
  messageText       String?
  mediaType         String?             // NONE, IMAGE, VIDEO, DOCUMENT, AUDIO
  mediaUrl          String?
  buttonsJson       String?
  batchRatePerMin   Int                 @default(60)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsAppAccount?    @relation(fields: [whatsappAccountId], references: [id])
  segment           Segment?            @relation(fields: [segmentId], references: [id])
  template          Template?           @relation(fields: [templateId], references: [id])
  recipients        CampaignRecipient[]
  scheduledLogs     ScheduledCampaign[]
  messages          Message[]
}

model CampaignRecipient {
  id          String   @id @default(uuid())
  campaignId  String
  contactId   String
  status      String   @default("PENDING") // PENDING, PROCESSING, SENT, DELIVERED, READ, FAILED, OPTED_OUT
  errorMessage String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
}

model ScheduledCampaign {
  id          String    @id @default(uuid())
  campaignId  String
  runAt       DateTime
  recurring   String?   // NONE, DAILY, WEEKLY, MONTHLY
  status      String    @default("PENDING") // PENDING, RUNNING, EXECUTED, CANCELED
  lastRunAt   DateTime?

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Message {
  id            String         @id @default(uuid())
  companyId     String
  campaignId    String?
  contactId     String
  direction     String         @default("OUTBOUND") // OUTBOUND, INBOUND
  wabaMessageId String?
  type          String         @default("TEXT") // TEXT, IMAGE, VIDEO, DOCUMENT, AUDIO, TEMPLATE, BUTTON
  content       String
  mediaUrl      String?
  status        String         @default("SENT") // PENDING, PROCESSING, SENT, DELIVERED, READ, FAILED
  attempts      Int            @default(1)
  errorDetail   String?
  sentAt        DateTime       @default(now())
  deliveredAt   DateTime?
  readAt        DateTime?

  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  events        MessageEvent[]
}

model MessageEvent {
  id        String   @id @default(uuid())
  messageId String
  event     String   // PENDING, SENT, DELIVERED, READ, REPLIED, FAILED
  details   String?
  timestamp DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String         @id @default(uuid())
  companyId     String
  contactId     String
  unreadCount   Int            @default(0)
  lastMessage   String?
  lastMessageAt DateTime       @default(now())
  status        String         @default("OPEN") // OPEN, CLOSED, PENDING
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inboxMessages InboxMessage[]

  @@unique([companyId, contactId])
}

model InboxMessage {
  id             String       @id @default(uuid())
  conversationId String
  sender         String       // CONTACT, OPERATOR, BOT
  senderName     String?
  text           String
  mediaUrl       String?
  wabaMessageId  String?
  status         String       @default("DELIVERED") // SENT, DELIVERED, READ
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Automation {
  id          String           @id @default(uuid())
  companyId   String
  name        String
  description String?
  triggerType String           // NEW_CONTACT, MESSAGE_RECEIVED, INACTIVITY_DAYS, CAMPAIGN_CLICK
  status      String           @default("ACTIVE") // ACTIVE, PAUSED
  executionCount Int           @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps       AutomationStep[]
}

model AutomationStep {
  id           String     @id @default(uuid())
  automationId String
  stepOrder    Int
  type         String     // CONDITION, ACTION_SEND_MSG, ACTION_ADD_TAG, ACTION_CREATE_SEGMENT, DELAY
  configJson   String     // Rules configuration JSON
  createdAt    DateTime   @default(now())

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
}

model OptOut {
  id        String   @id @default(uuid())
  companyId String
  contactId String?
  phone     String
  reason    String?  @default("USER_REQUEST")
  source    String   @default("WHATSAPP_STOP") // WHATSAPP_STOP, MANUAL, LINK, LGPD_REQUEST
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  action    String   // LOGIN, CREATE_CAMPAIGN, EXPORT_CONTACTS, DELETE_CONTACT, LGPD_ERASURE, DISPATCH_CAMPAIGN
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}
